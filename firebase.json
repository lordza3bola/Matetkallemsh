{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "tests/**", "tools/**", "data/**", "README.md", "package.json"],
    "headers": [
      { "source": "/@(index.html|sw.js|manifest.json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/js/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/css/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/icons/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
